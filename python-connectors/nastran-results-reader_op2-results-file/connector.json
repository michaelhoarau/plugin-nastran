{
    "meta" : {
        "label": "Custom dataset nastran-results-reader_op2-results-file",
        "description": "",
        "icon": "fas fa-table"
    },

    "readable": true,
    "writable": true,
    "supportAppend": false,
    "paramsPythonSetup": "compute-op2-files-list.py",
    "params": [
        {
          "name": "managed_folder",
          "label": "Managed folder",
          "type": "MANAGED_FOLDER",
          "description": "Select the managed folder where your OP2 file is stored",
          "mandatory": true
        },
        {
          "name": "op2_file",
          "label": "OP2 file",
          "type": "SELECT",
          "description": "Select the OP2 file to post-process",
          "mandatory": true,
          "getChoicesFromPython": true,
          "visibilityCondition": "model.managed_folder != 'Nothing selected'"
        }
    ]
}
